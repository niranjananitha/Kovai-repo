# Copy this file to .env and fill in the values. Never commit .env.

# Signs the session cookie. Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. The "Client ID" of your Google OAuth Web client (ends in .apps.googleusercontent.com).
# Needed only for the "Continue with Google" button; email and password sign-in works without it.
GOOGLE_CLIENT_ID=

# PostgreSQL connection string (e.g. from Neon). Paste only the string that starts with postgresql://
# (no quotes, no "psql" in front). Leave empty locally to use a SQLite file.
DATABASE_URL=

# Exactly "production" on the hosting service: it turns on Secure cookies and requires SECRET_KEY.
# Leave empty locally.
FLASK_ENV=
