# Copy this file to .env and fill in the values. Never commit .env.

# Signs the session cookie. Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The "Client ID" of your Google OAuth Web client (ends in .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# PostgreSQL connection string (e.g. from Neon). Leave empty locally to use a SQLite file.
DATABASE_URL=

# "production" turns on Secure cookies and requires SECRET_KEY. Leave empty locally.
FLASK_ENV=
